NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/yuksalish
# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Vergul bilan ajratilgan frontend manzillari (admin, public)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

BCRYPT_COST=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
# Caddy/proxy orqasida ishlasa 1 qo'ying
TRUST_PROXY=0
ENABLE_DOCS=true

# scripts/seed.ts uchun
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=ChangeMe123
SEED_SUPERADMIN_FULLNAME=Super Admin

# Server ishga tushirish
# npm run seed
# npm run dev

# Ochiq reyting frontendi originlari (bo'sh bo'lsa CORS_ORIGINS)
PUBLIC_CORS_ORIGINS=http://localhost:5174
PUBLIC_RATE_LIMIT_PER_MIN=120
# Kechasi 02:00 (Asia/Tashkent) reytingni qayta hisoblash
JOBS_ENABLED=true
# Baho o'zgargach reytingni qayta hisoblashgacha kutish (debounce)
RATING_DEBOUNCE_MS=5000

# Hisobotda max qator soni
REPORTS_MAX_ROWS=5000
# Audit loglarni saqlash muddati (kun); bo'sh = abadiy
AUDIT_RETENTION_DAYS=
