# Serverda shu faylni /opt/yuksalish/Yuksalish_backend/ ichida `.env` nomi bilan nusxalang va to'ldiring:
#   cd /opt/yuksalish/Yuksalish_backend && cp deploy/production.env.example .env && chmod 600 .env
# CHANGE_ME_... qiymatlari qoldirilsa, API productionda ishga tushmaydi (env-guard) / seed rad etiladi.
# Parollarni QO'LDA o'ylab topmang, generatsiya qiling:  openssl rand -hex 24
# (hex belgilar Mongo URI da maxsus kodlashni talab qilmaydi — shuning uchun hex ishlating)

# `docker compose` buyruqlari avtomatik shu faylni ishlatsin
COMPOSE_FILE=docker-compose.prod.yml

# ---- Domenlar (DNS da ikkalasi ham VPS IP manziliga A-yozuv bilan ko'rsatilgan bo'lishi shart) ----
PUBLIC_DOMAIN=reyting.example.uz
ADMIN_DOMAIN=admin.reyting.example.uz
# Let's Encrypt xabarnomalari uchun haqiqiy email
ACME_EMAIL=you@example.uz

# ---- MongoDB ----
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_24
MONGO_APP_USER=yuksalish_app
MONGO_APP_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ---- API ----
# Kamida 32 belgi:  openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_48
ENABLE_DOCS=false
# Audit loglarni saqlash muddati (kun); bo'sh = abadiy
AUDIT_RETENTION_DAYS=

# ---- Birinchi superadmin (faqat birinchi seed uchun; kamida 8 belgi, harf + raqam) ----
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_kuchli_parol_123
SEED_SUPERADMIN_FULLNAME=Super Admin

# ---- Backup (ixtiyoriy) ----
# BACKUP_DIR=/var/backups/yuksalish
# BACKUP_KEEP_DAYS=14
